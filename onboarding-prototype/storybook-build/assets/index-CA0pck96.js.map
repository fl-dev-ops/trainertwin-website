 {
  "back": "Explaining yield and ROI to investors",
  "name": "Leo",
  "tone": 4,
  "subs": [
   "Explaining yield and ROI to investors",
   "Monday, 9:18 am · 6 min"
  ],
  "video": "../media/twin-speaking.mp4#t=0.5",
  "caption": "Recording · 6 min",
  "fb": {
   "stars": null,
   "tone": "",
   "num": "",
   "rest": "",
   "quote": ""
  },
  "issues": [],
  "topics": [
   "Gross vs net yield",
   "Service charges",
   "Worst, average, best case"
  ],
  "lines": [
   {
    "who": "Leo",
    "twin": false,
    "text": "Is the rental yield really 9%?"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "That is the gross figure. Take off service charges, vacancy and fees, then show the net next to it."
   },
   {
    "who": "Leo",
    "twin": false,
    "text": "How do I show risk without scaring the investor?"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "Show worst, average and best case from past transactions, and say which one you’d plan around."
   },
   {
    "who": "Leo",
    "twin": false,
    "text": "Should I mention resale?"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "Yes. Give the exit route before they ask: who buys this unit type and how long it took last year."
   }
  ],
  "rateSvgs": [
   "<svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 11v9H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3zm0 0 4.2-6.3A1.5 1.5 0 0 1 14 5.6V9h4.2a2 2 0 0 1 2 2.3l-1 6.5a2 2 0 0 1-2 1.7H7\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"></path></svg>",
