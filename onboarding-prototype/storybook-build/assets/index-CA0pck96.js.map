  "name": "Aisha",
  "tone": 1,
  "subs": [
   "Opening a cold call",
   "Today, 2:14 pm · 6 min"
  ],
  "video": "../media/twin-speaking.mp4#t=0.5",
  "caption": "Recording · 6 min",
  "fb": {
   "stars": 5,
   "tone": "is-great",
   "num": "5",
   "rest": "/ 5 · How helpful is Olga’s twin?",
   "quote": ""
  },
  "issues": [],
  "topics": [
   "The opening line",
   "One comparable",
   "Handling “not interested”"
  ],
  "lines": [
   {
    "who": "Aisha",
    "twin": false,
    "text": "How do I open a cold call?"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "Say who you are and why you’re calling in one sentence, then offer one comparable sale."
   },
   {
    "who": "Aisha",
    "twin": false,
    "text": "They say “not interested.”"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "Agree, then ask one question: “Would you like to know what the unit next door sold for?”"
   },
   {
    "who": "Aisha",
    "twin": false,
    "text": "What if I get voicemail?"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "Leave your name, the building and one number. Keep it under twenty seconds and text afterwards."
   }
  ],
  "rateSvgs": [
   "<svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 11v9H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3zm0 0 4.2-6.3A1.5 1.5 0 0 1 14 5.6V9h4.2a2 2 0 0 1 2 2.3l-1 6.5a2 2 0 0 1-2 1.7H7\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"></path></svg>",
