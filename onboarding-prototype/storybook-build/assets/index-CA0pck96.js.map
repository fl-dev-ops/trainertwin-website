  "lines": [
   {
    "who": "Nora",
    "twin": false,
    "text": "When do I walk away?"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "When the fee drops below the cost of doing the job well. Say so kindly and leave the door open."
   },
   {
    "who": "Nora",
    "twin": false,
    "text": "The client asks if I can do it for one percent."
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "Don’t say no or yes. Name the work in the fee, then ask which part they’d like you to skip."
   },
   {
    "who": "Nora",
    "twin": false,
    "text": "Another agent quoted less. What now?"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "Ask what that quote includes. Compare photography, viewings and follow-up, not the percentage."
   }
  ],
