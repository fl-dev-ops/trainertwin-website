  "topics": [
   "Naming the work",
   "One percent ask",
   "Trading scope for fee"
  ],
  "lines": [
   {
    "who": "Aisha",
    "twin": false,
    "text": "The client asks if I can do it for one percent."
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "Don’t say no or yes. Name the work in the fee, then ask which part they’d like you to skip."
   },
   {
    "who": "Aisha",
    "twin": false,
    "text": "Another agent quoted less. What now?"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "Ask what that quote includes. Compare photography, viewings and follow-up, not the percentage."
   },
   {
    "who": "Aisha",
    "twin": false,
    "text": "When do I walk away?"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "When the fee drops below the cost of doing the job well. Say so kindly and leave the door open."
   }
  ],
  "rateSvgs": [
   "<svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 11v9H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3zm0 0 4.2-6.3A1.5 1.5 0 0 1 14 5.6V9h4.2a2 2 0 0 1 2 2.3l-1 6.5a2 2 0 0 1-2 1.7H7\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"></path></svg>",
