  "lines": [
   {
    "who": "Nora",
    "twin": false,
    "text": "What do I bring to the presentation?"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "A one-page plan: price range, marketing steps, viewing schedule and what you need from them."
   },
   {
    "who": "Nora",
    "twin": false,
    "text": "The seller asks “why should I list with you?”"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "Don’t list your awards. Show last quarter’s sales on their street and what you’ll do differently in week one."
   },
   {
    "who": "Nora",
    "twin": false,
    "text": "How do I handle a seller who wants a price far above market?"
   },
   {
    "who": "My twin",
    "twin": true,
    "text": "Put three recent sales side by side and ask which of them looks most like their home."
   }
  ],
  "rateSvgs": [
